            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\" />\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n  \n  <title>Thompson & Co Collective</title>\n  <meta name=\"description\" content=\"Employer branding and recruitment marketing that moves hiring outcomes. EVP, candidate experience, and media that drives measurable results.\" />\n  <link rel=\"canonical\" href=\"https://thompsoncollective.co/\" />\n\n  <!-- Open Graph / Facebook -->\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:url\" content=\"https://thompsoncollective.co\" />\n  <meta property=\"og:title\" content=\"Thompson & Co Collective - Employer Brand & Recruitment Marketing\" />\n  <meta property=\"og:description\" content=\"Employer branding and recruitment marketing that moves hiring outcomes. EVP, candidate experience, and media that drives measurable results.\" />\n  <meta property=\"og:image\" content=\"https://thompsoncollective.co/logo.png\" />\n\n  <!-- Twitter -->\n  <meta property=\"twitter:card\" content=\"summary_large_image\" />\n  <meta property=\"twitter:url\" content=\"https://thompsoncollective.co\" />\n  <meta property=\"twitter:title\" content=\"Thompson & Co Collective - Employer Brand & Recruitment Marketing\" />\n  <meta property=\"twitter:description\" content=\"Strategic employer branding and recruitment marketing that moves hiring outcomes. EVP development, candidate experience, and media governance that drives measurable results.\" />\n  <meta property=\"twitter:image\" content=\"https://thompsoncollective.co/logo.png\" />\n\n  <!-- Preconnect to external domains -->\n  <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\" />\n  <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin />\n  <link rel=\"preconnect\" href=\"https://www.googletagmanager.com\" />\n  <link rel=\"preconnect\" href=\"https://www.clarity.ms\" />\n\n  <!-- Favicon -->\n  <link r